{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command",
            "command": "python3 .claude/hooks/fence.py" }
        ]
      }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command",
                     "command": "python3 .claude/hooks/warm-start.py" } ] }
    ]
  }
}
